{
  "manifest_version": 3,
  "name": "PES University Auto Login",
  "version": "3.0",
  "description": "Instantly re-logs into PES University Wi-Fi portal on logout or session expiry.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "offscreen"],
  "host_permissions": ["http://192.168.254.1:8090/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://192.168.254.1:8090/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
